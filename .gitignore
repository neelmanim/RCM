docs/analysis/
docs/daily_logs/

# frontend-react/src/generated/version.js is generated from VERSION by
# scripts/sync-version.mjs, but is only ever consumed at Vite build time
# (like any other bundle source) — its *output* (the built nav-hub.js etc.)
# is what's committed and served, same as every other bundle. Ignored here.
#
# frontend/js/generated-version.js is NOT ignored: frontend/ is deployed as
# a raw static site with no build step (Render's frontend service just runs
# `echo ... > config.js`), so this file must be committed directly — there's
# nothing that would regenerate it at deploy time otherwise.
frontend-react/src/generated/version.js

# Personal Claude Code config (may hold personal MCP server registrations
# with private API keys, e.g. the `alternatecrm` MCP server — see
# docs/MCP_SETUP.md). Previously only excluded by contributors' own global
# gitignore, not this repo's — new clones had no protection against
# accidentally committing a personal key here.
.claude/settings.local.json
