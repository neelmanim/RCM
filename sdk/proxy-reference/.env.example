# Alternate Messenger Dialer SDK — Reference Proxy Environment
# ====================================================
# Copy this file to .env and fill in your credentials.

# Alternate Messenger API credentials
# Obtain from your Alternate Messenger dashboard or support team
MESSENGER_BASE_URL=https://api.alternatecrm.com
MESSENGER_API_KEY=your_messenger_api_key_here
MESSENGER_USER_ID=your_messenger_user_id_here
MESSENGER_FROM_NUMBER=+15550000000

# Optional: Alternate Messenger webhook signature secret
# Only needed if Alternate Messenger support has configured a webhook secret for your account
MESSENGER_WEBHOOK_SECRET=

# CORS — set to your frontend origin in production (e.g. https://yourapp.com)
# Use * only for local development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
