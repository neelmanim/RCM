# Conversive Dialer SDK — Reference Proxy Environment
# ====================================================
# Copy this file to .env and fill in your credentials.

# Conversive API credentials
# Obtain from your Conversive dashboard or support team
CONVERSIVE_BASE_URL=https://api.beconversive.com
CONVERSIVE_API_KEY=your_conversive_api_key_here
CONVERSIVE_USER_ID=your_conversive_user_id_here
CONVERSIVE_FROM_NUMBER=+15550000000

# Optional: Conversive webhook signature secret
# Only needed if Conversive support has configured a webhook secret for your account
CONVERSIVE_WEBHOOK_SECRET=

# CORS — set to your frontend origin in production (e.g. https://yourapp.com)
# Use * only for local development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
