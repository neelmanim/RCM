# ─── Salesforce API Credentials ────────────────────────────────────────────────
SF_USERNAME=your_username@agentforce.com
SF_PASSWORD=your_password
SF_SECURITY_TOKEN=your_token
SF_DOMAIN=login  # Use 'login' for production

# ─── Auth Secrets ─────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com > APIs & Services > Credentials
# Set Authorized Redirect URI to: https://your-app-name.onrender.com/api/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-app-name.onrender.com/api/auth/callback

# REQUIRED — app will not start without this
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-random-long-secret-string

# Demo login (default: false — set to true ONLY in local dev)
ALLOW_DEMO=false

# Encryption key for stored credentials (Salesforce, Nylas, Aircall)
# Generate with: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# APP_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# ─── Database Strategy ────────────────────────────────────────────────────────
# If using Render PostgreSQL, DATABASE_URL will be injected automatically.
# DATABASE_URL=postgresql://user:password@localhost/dbname
