# ─── RCM Backend — Environment Variables ────────────────────────────────────
# Copy to .env and fill in your values. NEVER commit .env to git.
# On Railway: set these in Dashboard → Variables instead.

# ─── App Identity ──────────────────────────────────────────────────────────────
APP_NAME=RCM
ENVIRONMENT=production
FRONTEND_URL=https://alternatecrm.com
ALLOWED_ORIGINS=https://alternatecrm.com,https://app.alternatecrm.com

# ─── Auth Secrets ─────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-random-long-secret-string

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
# Authorized Redirect URI: https://api.alternatecrm.com/api/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://api.alternatecrm.com/api/auth/callback

# ─── Database ─────────────────────────────────────────────────────────────────
# Railway auto-injects DATABASE_URL when Postgres plugin is added
DATABASE_URL=postgresql://user:password@localhost/rcm

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# ─── Salesforce (optional — only if Salesforce integration is used) ───────────
SF_USERNAME=your_username@company.com
SF_PASSWORD=your_sf_password
SF_SECURITY_TOKEN=your_sf_token
SF_DOMAIN=login

# ─── Nylas (Calendar/Email sync) ─────────────────────────────────────────────
NYLAS_API_KEY=your_nylas_api_key
NYLAS_CLIENT_ID=your_nylas_client_id
NYLAS_CLIENT_SECRET=your_nylas_client_secret

# ─── Aircall (Dialer) ─────────────────────────────────────────────────────────
AIRCALL_API_ID=your_aircall_api_id
AIRCALL_API_TOKEN=your_aircall_api_token
AIRCALL_WEBHOOK_TOKEN=your_webhook_verification_token

# ─── AI / LLM (via OmniRoute gateway) ────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OMNI_ROUTE_API_KEY=your_omni_route_key
OMNI_ROUTE_BASE_URL=https://omni.route/v1

# ─── Dev Only ─────────────────────────────────────────────────────────────────
# Demo login (default: false — set to true ONLY in local dev)
ALLOW_DEMO=false
